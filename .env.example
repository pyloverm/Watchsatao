# Secret exigé par /api/check. Vercel l'envoie en `Authorization: Bearer …`.
CRON_SECRET=

# Envoi des emails (Resend). Sans ces trois variables, l'envoi est ignoré.
RESEND_API_KEY=
MAIL_FROM="satao-watch <alertes@exemple.pt>"
MAIL_TO=

# Mémorisation de l'état précédent (Upstash Redis). Optionnel : sans elle,
# chaque exécution trouvant un concours ouvert renotifie.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
