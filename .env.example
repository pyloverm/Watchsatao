# Secret exigé par /api/check. Vercel l'envoie en `Authorization: Bearer …`.
CRON_SECRET=

# Envoi des emails (Resend). Sans ces trois variables, l'envoi est ignoré :
# la vérification continue de tourner, mais n'avertit personne.
RESEND_API_KEY=
MAIL_FROM="satao-watch <alertes@exemple.pt>"
MAIL_TO=

# Mémorisation entre exécutions (Upstash Redis). Optionnel, mais vivement
# conseillé : sans elle, chaque exécution qui trouve un concours ouvert
# renotifie, et chaque exécution en anomalie réémet l'alerte technique.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
